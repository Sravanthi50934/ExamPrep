# Server Port (local dev only; Vercel assigns its own port)
PORT=5000

# Node environment
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/exam_prep_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/exam_prep_tracker

# JWT Authentication Secret — use a long random string in production
JWT_SECRET=your_jwt_secret_key_here

# JWT Expiration
JWT_EXPIRES_IN=7d

# Production frontend URL (set this in Vercel environment variables for the backend project)
# Example: https://exam-prep-client.vercel.app
FRONTEND_URL=http://localhost:5173
